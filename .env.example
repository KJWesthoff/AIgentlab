# Copy to .env and fill in. Then: chmod 600 .env
OPENROUTER_API_KEY=your-key-here

# Optional: register BloodHound custom node icons with
# `agentlab-graph --register-icons <url>`. BloodHound shows both
# values once, under Administration -> API Tokens. The key signs
# requests and is never transmitted.
BLOODHOUND_TOKEN_ID=
BLOODHOUND_TOKEN_KEY=
